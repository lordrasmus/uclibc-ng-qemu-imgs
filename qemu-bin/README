# qemu-bin/ -- single qemu binaries, ahead of qemu-inst.tar.xz
#
# The qemu job of the CI (z_qemu_test_run.yml) takes qemu-bin/<binary>.xz, if
# there is one for the first word of the target's qemu command, over the
# binary from qemu-inst.tar.xz.  That lets one machine change without
# rebuilding and re-uploading every qemu.
#
# The binaries are statically linked, so they run on any x86_64 Linux host,
# and are built from the qemu fork (lordrasmus/qemu, branch uclibc-ng).
#
# qemu-system-m68k.xz  b3c06ca3a4 (virtio-mmio disk on mcf5208evb), built on
#                      the runner container:
#
#   ../configure --target-list=m68k-softmmu --static --disable-gio \
#     --python=/opt/python3.12/bin/python3.12
#   make
#   strip qemu-system-m68k
#   xz -9 qemu-system-m68k
#
# qemu-system-frv.xz   f137a3955b on branch frv, cherry-picked to uclibc-ng as
#                      b111fe1771 (virtio-mmio disk on mb93091), built on the
#                      runner container:
#
#   ../configure --target-list=frv-softmmu --static --disable-gio \
#     --python=/opt/python3.12/bin/python3.12
#   make
#   strip qemu-system-frv
#   xz -9 qemu-system-frv
#
# qemu-system-cris.xz  e13560648b (axis-dev88 back for CRISv32, with -initrd
#                      and a virtio-mmio disk; a virtio-mmio disk on
#                      etrax100lx too; bwf on CRISv10 fixed; a CRISv10 delay
#                      slot whose fetch faults restarts at its branch),
#                      built on the runner container:
#
#   ../configure --target-list=cris-softmmu --static --disable-gio \
#     --python=/opt/python3.12/bin/python3.12
#   make
#   strip qemu-system-cris
#   xz -9 qemu-system-cris
