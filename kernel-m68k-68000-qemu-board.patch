diff -Nru a/arch/m68k/68000/qemu.c b/arch/m68k/68000/qemu.c
--- a/arch/m68k/68000/qemu.c	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/m68k/68000/qemu.c	2026-10-24 23:14:48.679593139 +0200
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * QEMU "m68328" machine: a 16550 UART on interrupt 2 (the 68328 UART line)
+ */
+#include <linux/init.h>
+#include <linux/platform_device.h>
+#include <linux/serial_8250.h>
+#include <asm/MC68328.h>
+#include "m68328.h"
+
+#define QEMU_UART_BASE	0xffffe000
+#define QEMU_UART_CLK	1843200
+
+static struct plat_serial8250_port qemu_uart_data[] = {
+	{
+		.mapbase	= QEMU_UART_BASE,
+		.membase	= (void __iomem *)(QEMU_UART_BASE),
+		.irq		= UART_IRQ_NUM,
+		.uartclk	= QEMU_UART_CLK,
+		.iotype		= UPIO_MEM,
+		.flags		= UPF_BOOT_AUTOCONF,
+	},
+	{ },
+};
+
+static struct platform_device qemu_uart = {
+	.name			= "serial8250",
+	.id			= PLAT8250_DEV_PLATFORM,
+	.dev.platform_data	= qemu_uart_data,
+};
+
+static int __init qemu_devices_init(void)
+{
+	return platform_device_register(&qemu_uart);
+}
+arch_initcall(qemu_devices_init);
+
+void __init init_qemu(char *command, int size)
+{
+}
