--- a/arch/c6x/kernel/switch_to.S
+++ b/arch/c6x/kernel/switch_to.S
@@ -15,6 +15,13 @@
 	 *		    struct task_struct *tsk) ;
 	 */
 ENTRY(__switch_to)
+	;; The user thread pointer lives in GPLYB, which the kernel never uses.
+	MVC	.S2	GPLYB,B0
+	LDW	.D2T2	*+B4(THREAD_TP),B1
+	STW	.D1T2	B0,*+A4(THREAD_TP)
+	NOP	3
+	MVC	.S2	B1,GPLYB
+
 	LDDW	.D2T2	*+B4(THREAD_B15_14),B7:B6
  ||	MV	.L2X	A4,B5	; prev
  ||	MV	.L1X	B4,A5	; next
--- a/arch/c6x/Makefile
+++ b/arch/c6x/Makefile
@@ -19,6 +19,10 @@
 KBUILD_CFLAGS   += $(cflags-y)
 KBUILD_AFLAGS   += $(cflags-y)
 
+# The kernel switches GPLYB, the user thread pointer, itself.
+KBUILD_CFLAGS   += $(call as-option,-Wa$(comma)-mno-tp-gplyb)
+KBUILD_AFLAGS   += $(call as-option,-Wa$(comma)-mno-tp-gplyb)
+
 ifdef CONFIG_CPU_BIG_ENDIAN
 KBUILD_CFLAGS   += -mbig-endian
 KBUILD_AFLAGS   += -mbig-endian
