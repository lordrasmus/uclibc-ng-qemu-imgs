# avr32: align the fixup code in __get_user_asm/__put_user_asm (Linux 4.4).
# The fixups go to .subsection 1, which starts right after whatever the
# compiler put there before -- often at an odd address.  AVR32 instructions
# must be halfword aligned, so the "mov %0, %4; rjmp 2b" of a fixup sat at an
# odd address, and the exception table pointed there.  A user access that
# faulted then jumped into the middle of an instruction instead of returning
# -EFAULT.  ".align 1" before the fixup label fixes it.
--- a/arch/avr32/include/asm/uaccess.h	2026-10-24 17:56:56.770928125 +0200
+++ b/arch/avr32/include/asm/uaccess.h	2026-10-24 17:56:56.762927938 +0200
@@ -244,6 +244,7 @@
 		"1:	ld." suffix "	%1, %3			\n"	\
 		"2:						\n"	\
 		"	.subsection 1				\n"	\
+		"	.align	1				\n"	\
 		"3:	mov	%0, %4				\n"	\
 		"	rjmp	2b				\n"	\
 		"	.subsection 0				\n"	\
@@ -309,6 +310,7 @@
 		"1:	st." suffix "	%1, %3			\n"	\
 		"2:						\n"	\
 		"	.subsection 1				\n"	\
+		"	.align	1				\n"	\
 		"3:	mov	%0, %4				\n"	\
 		"	rjmp	2b				\n"	\
 		"	.subsection 0				\n"	\
