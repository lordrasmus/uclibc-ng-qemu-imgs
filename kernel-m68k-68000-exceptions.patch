 asmlinkage irqreturn_t bad_interrupt(int, void *);
 asmlinkage irqreturn_t inthandler(void);
 asmlinkage irqreturn_t inthandler1(void);
@@ -71,6 +42,71 @@ asmlinkage irqreturn_t inthandler5(void);
 asmlinkage irqreturn_t inthandler6(void);
 asmlinkage irqreturn_t inthandler7(void);
 
+/* the CPU exception stubs in entry.S, one per vector */
+#define EXCEPTION_STUB(vec) asmlinkage void exception##vec(void);
+EXCEPTION_STUB(2) EXCEPTION_STUB(3) EXCEPTION_STUB(4) EXCEPTION_STUB(5)
+EXCEPTION_STUB(6) EXCEPTION_STUB(7) EXCEPTION_STUB(8) EXCEPTION_STUB(9)
+EXCEPTION_STUB(10) EXCEPTION_STUB(11) EXCEPTION_STUB(12) EXCEPTION_STUB(13)
+EXCEPTION_STUB(14) EXCEPTION_STUB(15)
+EXCEPTION_STUB(33) EXCEPTION_STUB(34) EXCEPTION_STUB(35) EXCEPTION_STUB(36)
+EXCEPTION_STUB(37) EXCEPTION_STUB(38) EXCEPTION_STUB(39) EXCEPTION_STUB(40)
+EXCEPTION_STUB(41) EXCEPTION_STUB(42) EXCEPTION_STUB(43) EXCEPTION_STUB(44)
+EXCEPTION_STUB(45) EXCEPTION_STUB(46) EXCEPTION_STUB(47)
+
+void die_if_kernel(char *str, struct pt_regs *fp, int nr);
+
+/*
+ * A CPU exception: the signals trap_c() sends for the other m68k, with
+ * the PC of the exception frame as the fault address, since the 68000
+ * stacks no format word to say more.
+ */
+asmlinkage void m68000_exception(int vec, struct pt_regs *regs)
+{
+	int sig, code;
+
+	switch (vec) {
+	case VEC_BUSERR:
+		sig = SIGBUS;
+		code = BUS_ADRERR;
+		break;
+	case VEC_ADDRERR:
+		sig = SIGBUS;
+		code = BUS_ADRALN;
+		break;
+	case VEC_PRIV:
+		sig = SIGILL;
+		code = ILL_PRVOPC;
+		break;
+	case VEC_ZERODIV:
+		sig = SIGFPE;
+		code = FPE_INTDIV;
+		break;
+	case VEC_CHK:
+	case VEC_TRAP:
+		sig = SIGFPE;
+		code = FPE_INTOVF;
+		break;
+	case VEC_TRACE:
+		sig = SIGTRAP;
+		code = TRAP_TRACE;
+		break;
+	case VEC_TRAP15:
+		sig = SIGTRAP;
+		code = TRAP_BRKPT;
+		break;
+	case VEC_TRAP1 ... VEC_TRAP14:
+		sig = SIGILL;
+		code = ILL_ILLTRP;
+		break;
+	default:
+		sig = SIGILL;
+		code = ILL_ILLOPC;
+		break;
+	}
+	die_if_kernel("Kernel mode exception", regs, vec);
+	force_sig_fault(sig, code, (void __user *) regs->pc);
+}
