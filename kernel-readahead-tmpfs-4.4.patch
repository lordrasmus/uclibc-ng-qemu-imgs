# readahead(2) on tmpfs for Linux 4.4 (avr32): the 4.4 version of
# kernel-readahead-tmpfs.patch, same change, made against linux-4.4.302.
# Backport of the effect of 3d8f7615319b ("vfs: implement readahead(2) using
# POSIX_FADV_WILLNEED", v4.19): 0 for a filesystem that cannot read ahead
# (tmpfs, the rootfs here), -EINVAL for non-regular files.
--- a/mm/readahead.c	2022-02-03 09:27:54.000000000 +0100
+++ b/mm/readahead.c	2026-10-24 16:24:28.872805565 +0200
@@ -546,7 +546,10 @@
 	if (!mapping || !mapping->a_ops)
 		return -EINVAL;
 
-	return force_page_cache_readahead(mapping, filp, index, nr);
+	/* like fadvise(POSIX_FADV_WILLNEED): a filesystem that cannot read
+	 * ahead (tmpfs) is no error */
+	force_page_cache_readahead(mapping, filp, index, nr);
+	return 0;
 }
 
 SYSCALL_DEFINE3(readahead, int, fd, loff_t, offset, size_t, count)
@@ -562,7 +565,10 @@
 			pgoff_t start = offset >> PAGE_CACHE_SHIFT;
 			pgoff_t end = (offset + count - 1) >> PAGE_CACHE_SHIFT;
 			unsigned long len = end - start + 1;
-			ret = do_readahead(mapping, f.file, start, len);
+
+			ret = -EINVAL;
+			if (S_ISREG(file_inode(f.file)->i_mode))
+				ret = do_readahead(mapping, f.file, start, len);
 		}
 		fdput(f);
 	}
