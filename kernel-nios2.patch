# nios2: gate syscall restart on the error flag (r7), not the stale r1.
# do_signal() used regs->r1 (the user's 'at' reg, an arbitrary value) to decide
# whether to do syscall-restart. That both missed real restarts (ERESTARTNOHAND
# leaked as errno 514 from pselect6) and, since the restart switch ignores the
# error flag, spuriously restarted SUCCESSFUL syscalls whose return value collides
# with a restart code (waitpid->child PID 512-516, read->512-516 bytes -> exit 255).
# Restart codes are only ever error returns (r7=1); gate on r7.
# Full description + reproducers in
# uclibc-ng/git/kernel-submit/0001-nios2-*.patch + nios2-*-reproducer.c
--- linux-6.5.10/arch/nios2/kernel/signal.c	2023-11-02 09:37:00.000000000 +0100
+++ ../linux-6.5.10/arch/nios2/kernel/signal.c	2026-06-10 15:29:55.529711324 +0200
@@ -242,7 +242,7 @@
 	/*
 	 * If we were from a system call, check for system call restarting...
 	 */
-	if (regs->orig_r2 >= 0 && regs->r1) {
+	if (regs->orig_r2 >= 0 && regs->r7) {
 		continue_addr = regs->ea;
 		restart_addr = continue_addr - 4;
 		retval = regs->r2;

# nios2: put ELF_ET_DYN_BASE inside the user address space.
# It was 0xD0000000, but nios2 ends its user space at TASK_SIZE 0x7FFF0000, so
# load_elf_binary() cannot map a PIE there: the MAP_FIXED_NOREPLACE mapping is
# rejected with -ENOMEM after begin_new_exec(), i.e. past the point of no
# return, and every exec of a PIE dies with SIGSEGV -- with the calling shell's
# registers in the dump, which makes it look like a crash in the new program.
# Without this all 11 -pie tests of the testsuite fail. Value as on sh.
# Full description in uclibc-ng/git/kernel-submit/0001-nios2-put-ELF_ET_DYN_BASE-*.patch
--- linux-6.5.10/arch/nios2/include/asm/elf.h
+++ ../linux-6.5.10/arch/nios2/include/asm/elf.h
@@ -23,7 +23,7 @@
    the loader.  We need to make sure that it is out of the way of the program
    that it will "exec", and that there is sufficient room for the brk.  */
 
-#define ELF_ET_DYN_BASE		0xD0000000UL
+#define ELF_ET_DYN_BASE		(2 * TASK_SIZE / 3)
 
 /* regs is struct pt_regs, pr_reg is elf_gregset_t (which is
    now struct_user_regs, they are different) */
